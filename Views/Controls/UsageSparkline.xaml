<UserControl
    x:Class="Gauge.Views.Controls.UsageSparkline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged"
    PointerMoved="OnPointerMoved" PointerExited="OnPointerExited"
    PointerCanceled="OnPointerExited" Unloaded="OnUnloaded">
    <Grid Background="{ThemeResource ControlFillColorTransparentBrush}">
        <Polyline x:Name="Ideal" Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
        <Polyline x:Name="Actual" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
    </Grid>
</UserControl>
