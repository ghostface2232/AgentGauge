<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gauge.Views.PopoverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:Gauge.Converters"
    xmlns:ctrl="using:Gauge.Views.Controls"
    xmlns:loc="using:Gauge.Localization"
    mc:Ignorable="d">

    <!-- RootHost is transparent so the DesktopAcrylic backdrop shows through. Its
         tree-level KeyboardAccelerator handles ESC without making the full-window
         Grid a focus target. It is the element we slide + fade on show. RootBorder
         is where we round corners if we ever
         switch from DWM rounding to the transparent-window + inner-border approach. -->
    <Grid x:Name="RootHost" Background="{ThemeResource ControlFillColorTransparentBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
          <ResourceDictionary>
            <!-- Hover/press overlay for borderless icon buttons. Stronger than the
                 system default so the affordance is clearly visible: a soft darken in
                 light theme, a soft lighten in dark theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="IconButtonPressedBrush" Color="#1A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="IconButtonPressedBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <conv:UsageLevelToBrushConverter x:Key="LevelToBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:PercentToGridLengthConverter x:Key="PercentToGridLength" />
            <conv:EmptyStringToNullConverter x:Key="EmptyToNull" />
            <Style x:Key="BorderlessIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{ThemeResource IconButtonHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                               Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{ThemeResource IconButtonPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Settings switches. The default ToggleSwitch template keeps a fixed 12dip
                 gap column between the 40dip switch and its On/Off text even when that text
                 is empty, so a bare switch sits 12dip inside the edge every other control
                 (dropdowns, buttons, chips) reaches. The negative right margin lets that
                 empty column hang past the slot so the switch itself lands on the edge. -->
            <Style x:Key="EdgeAlignedToggleSwitchStyle" TargetType="ToggleSwitch"
                   BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="Margin" Value="0,0,-12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Compact account card. Header carries the tool name and a disconnect
                 (remove) button; the body shows the CLI login button for Claude/Codex
                 or sign-in guidance for app-login tools (Antigravity/Cursor). -->
            <DataTemplate x:Key="AuthCardTemplate">
                <Border Padding="12" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ToolName}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button Grid.Column="1" Style="{StaticResource BorderlessIconButtonStyle}"
                                    MinWidth="28" MinHeight="28" Padding="6"
                                    Command="{Binding RemoveCommand}" ToolTipService.ToolTip="{loc:Localize Key=Tooltip_Disconnect}">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Opacity="0.75"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <!-- Show/hide: a state chip on the left ("표시"/"숨김") and a bare
                             switch on the right, on = shown. The long "hide · pause refresh"
                             header is gone; the chip says the state and the switch's
                             automation name/tooltip explains the off side. The two chips share
                             a cell and swap by visibility, so no bool-to-brush converter is
                             needed: the shown chip borrows the reset chip's informational
                             tint, the hidden one a neutral control fill. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctrl:SquircleBorder Grid.Column="0" VerticalAlignment="Center"
                                                 Radius="8" Smoothing="0.75" Padding="8,4,9,5"
                                                 Fill="{ThemeResource ResetChipFillBrush}"
                                                 Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Text="{Binding VisibilityText}"
                                           Foreground="{ThemeResource ResetChipTextBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </ctrl:SquircleBorder>
                            <ctrl:SquircleBorder Grid.Column="0" VerticalAlignment="Center"
                                                 Radius="8" Smoothing="0.75" Padding="8,4,9,5"
                                                 Fill="{ThemeResource ControlFillColorSecondaryBrush}"
                                                 Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11" Text="{Binding VisibilityText}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </ctrl:SquircleBorder>
                            <ToggleSwitch Style="{StaticResource EdgeAlignedToggleSwitchStyle}" Grid.Column="2"
                                          IsOn="{Binding IsShown, Mode=TwoWay}"
                                          AutomationProperties.Name="{loc:Localize Key=Settings_ShowTool}"
                                          ToolTipService.ToolTip="{loc:Localize Key=Settings_ShowTool}" />
                        </Grid>
                        <Button Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                Visibility="{Binding SupportsCliLogin, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
          </ResourceDictionary>
        </Grid.Resources>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        </Grid.KeyboardAccelerators>

        <!-- Usage view. RootBorder spans the window edges; padding is applied per
             region so the footer can be a full-bleed bottom bar (Win11 Start-menu
             style). DWM rounds the window's outer corners. -->
        <Border x:Name="RootBorder" VerticalAlignment="Stretch">
            <Border.RenderTransform>
                <TranslateTransform x:Name="UsageViewTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Fill the arranged client height so the window's small DPI
                         safety allowance is absorbed by the body. This keeps this
                         footer on the same bottom edge as the settings footer. -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App title header. Same vertical placement, padding and style as the
                     settings header so switching views keeps the title fixed in place;
                     no back button here since this is the root view. The 32dip min
                     height mirrors the settings header (whose back button sets that
                     height) so the gap below the title matches across both views. -->
                <Border Grid.Row="0" Padding="16,16,16,8">
                    <Grid MinHeight="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <!-- App mark sized to sit ~level with the 20pt title cap height.
                                 Source is set in code (UpdateTitleIcon) by decoding the .ico's
                                 largest frame so it stays sharp instead of upscaling the 16px
                                 entry a plain BitmapImage would pick. The 2dip left margin is an
                                 optical nudge so the round mark sits visually flush with the
                                 left edge rather than mathematically flush. -->
                            <Image x:Name="TitleIcon" Margin="2,0,0,0"
                                   Width="22" Height="22" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="AgentGauge"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body: cards when there is data, otherwise a guidance message.
                     Padded region; BodyScroll caps its height in code so the window
                     never exceeds MaxPopoverHeightDip — taller content scrolls here.
                     No bottom padding so scrolling content clips flush at the footer
                     divider instead of vanishing into an empty band above it. -->
                <!-- Horizontal padding lives on the ScrollViewer (not this Border) so the
                     auto-hide overlay scrollbar sits in the right gutter rather than over the
                     cards' right edge. -->
                <Border Grid.Row="1" Padding="0">
                <Grid>
                <!-- Centered guidance shown when no tool has any data. When the cause is
                     actionable from settings (nothing signed in / fetch failed), an inline
                     "Open Settings" button gives new users the path the text alone hides. -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="16,0"
                    Spacing="12"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        Text="{Binding EmptyMessage}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="OnSettingsClicked"
                        Content="{loc:Localize Key=Action_OpenSettings}"
                        Visibility="{Binding IsSettingsCtaVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <ScrollViewer
                    x:Name="BodyScroll"
                    Padding="16,0,16,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <!-- Inter-card spacing lives on the panel (not a per-card bottom margin)
                         so the last card carries no trailing margin: scrolled content clips
                         flush under the footer instead of leaving a thin band above it. -->
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" Loaded="OnUsagePanelLoaded" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="14,14,14,8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <!-- Tool name + plan tier (lighter, e.g. "Max 5x" / "Plus") on
                                             the left; the reset-credit chip pushed to the right edge,
                                             where its separation from the name/plan run says it is a
                                             balance the account holds rather than a property of the
                                             plan. -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Text="{Binding ToolName}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.5"
                                                FontSize="15"
                                                Text="{Binding Plan}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}" />
                                            <!-- This month's API-equivalent cost estimate, beside the
                                                 plan in the same dimmed caption so it reads as a
                                                 property of the account, not a usage value. Opt-in
                                                 (settings); the tooltip spells out the token mix and
                                                 that it is an estimate, never a bill. -->
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.5"
                                                FontSize="15"
                                                Text="{Binding ApiCostText}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                AutomationProperties.Name="{Binding ApiCostDescription}"
                                                ToolTipService.ToolTip="{Binding ApiCostDescription}"
                                                Visibility="{Binding HasApiCost, Converter={StaticResource BoolToVis}}" />
                                            <!-- Keep stale last-good data visibly and semantically
                                                 labeled. Unlike a color-only dot, this text is exposed
                                                 by the TextBlock automation peer and needs no hover or
                                                 keyboard focus to communicate the failed refresh. -->
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource UsageCautionTextBrush}"
                                                Text="{loc:Localize Key=Status_RefreshIssue}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                AutomationProperties.Name="{loc:Localize Key=Tooltip_RefreshIssue}"
                                                ToolTipService.ToolTip="{loc:Localize Key=Tooltip_RefreshIssue}"
                                                Visibility="{Binding HasRefreshIssue, Converter={StaticResource BoolToVis}}" />
                                            <!-- Small indeterminate ring while a refresh attempt covering
                                                 this tool is in flight. It lives in the header — not beside
                                                 each row's reset caption — because a refresh is per-tool,
                                                 the header exists in both bar and gauge modes, and sitting
                                                 right of the stale badge lets "갱신 실패 + ring" read as
                                                 "stale, but a retry is running". Gray (secondary text
                                                 brush) rather than accent so it reads as ambient status,
                                                 not a call to action. IsActive is bound too so the
                                                 animation only runs while visible. -->
                                            <ProgressRing
                                                Width="14"
                                                Height="14"
                                                MinWidth="14"
                                                MinHeight="14"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsActive="{Binding IsRefreshing}"
                                                AutomationProperties.Name="{loc:Localize Key=Status_Refreshing}"
                                                ToolTipService.ToolTip="{loc:Localize Key=Status_Refreshing}"
                                                Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                            <!-- Header chip row: right-aligned, so with one chip it
                                                 sits on the header's right edge and with both they
                                                 line up side by side from that edge — the status
                                                 chip first, the reset chip keeping the edge. -->
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                                <!-- Service-wide incident/maintenance chip. Same squircle,
                                                     padding, icon size and caption size as the reset chip
                                                     beside it so the two header chips are one family, but on
                                                     the warm StatusChip* tint because it flags a condition.
                                                     It stays a HyperlinkButton (opens the status page, so it
                                                     keeps the link role and keyboard focus) with the chip as
                                                     its content; the button's own padding is zeroed so the
                                                     squircle is the whole hit target. -->
                                                <HyperlinkButton
                                                    NavigateUri="{Binding StatusPageUrl}"
                                                    VerticalAlignment="Center" Padding="0" MinHeight="0"
                                                    CornerRadius="8"
                                                    AutomationProperties.Name="{Binding ServiceStatusDescription}"
                                                    ToolTipService.ToolTip="{Binding ServiceStatusDescription}"
                                                    Visibility="{Binding HasServiceStatus, Converter={StaticResource BoolToVis}}">
                                                    <ctrl:SquircleBorder
                                                        Radius="8"
                                                        Smoothing="0.75"
                                                        Padding="8,4,9,5"
                                                        Fill="{ThemeResource StatusChipFillBrush}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                Glyph="&#xE7BA;"
                                                                Foreground="{ThemeResource StatusChipTextBrush}" />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="11"
                                                                Text="{Binding ServiceStatusText}"
                                                                Foreground="{ThemeResource StatusChipTextBrush}"
                                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                                        </StackPanel>
                                                    </ctrl:SquircleBorder>
                                                </HyperlinkButton>
                                                <!-- Manual rate-limit resets the account holds (Codex).
                                                     A chip rather than another plain caption, because this
                                                     is a countable balance and not a property of the plan;
                                                     the squircle keeps it from reading as a clickable pill,
                                                     and the tinted fill alone carries it — an outline would
                                                     add a second edge next to the card's own. The chip text
                                                     is terse, so the spelled-out form goes to the tooltip
                                                     and the automation peer. -->
                                                <ctrl:SquircleBorder
                                                    VerticalAlignment="Center"
                                                    Radius="8"
                                                    Smoothing="0.75"
                                                    Padding="8,4,9,5"
                                                    Fill="{ThemeResource ResetChipFillBrush}"
                                                    AutomationProperties.Name="{Binding ResetCreditsDescription}"
                                                    ToolTipService.ToolTip="{Binding ResetCreditsDescription}"
                                                    Visibility="{Binding HasResetCredits, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Glyph="&#xE72C;"
                                                            Foreground="{ThemeResource ResetChipTextBrush}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Text="{Binding ResetCreditsText}"
                                                            Foreground="{ThemeResource ResetChipTextBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </ctrl:SquircleBorder>
                                            </StackPanel>
                                        </Grid>

                                        <!-- The tool's windows, rendered as bars or gauges per the
                                             app-wide view mode. Both share the same Windows source;
                                             exactly one is visible (IsBarMode / IsGaugeMode), and the
                                             whole block is shown only when the tool has data. -->
                                        <Grid Visibility="{Binding HasAnyData, Converter={StaticResource BoolToVis}}">
                                        <!-- Bar layout: one stacked row per window (5시간 / 주간). -->
                                        <ItemsControl
                                            ItemsSource="{Binding Windows}"
                                            Visibility="{Binding IsBarMode, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2" Margin="0,0,0,10">
                                                        <!-- Separator between adjacent model
                                                             families (e.g. Gemini | Claude/GPT). -->
                                                        <Border
                                                            Height="1"
                                                            Margin="0,2,0,10"
                                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                            Visibility="{Binding ShowGroupDivider, Converter={StaticResource BoolToVis}}" />
                                                        <!-- Model-family heading (e.g. "Gemini",
                                                             "Claude/GPT"), shown once above the
                                                             first row of each group. -->
                                                        <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                            Margin="0,2,0,4"
                                                            Opacity="0.9"
                                                            FontSize="13"
                                                            Text="{Binding GroupHeader}"
                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                            Visibility="{Binding HasGroupHeader, Converter={StaticResource BoolToVis}}" />
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock AutomationProperties.Name="{Binding AccessibilityName}"
                                                                Grid.Column="0"
                                                                MinWidth="44"
                                                                VerticalAlignment="Center"
                                                                Opacity="0.8"
                                                                Text="{Binding Label}"
                                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                                            <!-- Custom progress bar: rounded track with a rounded fill sized by
                                                                 percent. Thicker and clearly a progress bar (not the thin,
                                                                 slider-like default). Height/CornerRadius easy to tune. -->
                                                            <Border
                                                                Grid.Column="1"
                                                                Height="8"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource ControlAltFillColorTertiaryBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToGridLength}}" />
                                                                        <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToGridLength}, ConverterParameter=rest}" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border
                                                                        Grid.Column="0"
                                                                        CornerRadius="4"
                                                                        Background="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                                                </Grid>
                                                            </Border>
                                                            <ctrl:UsageSparkline Grid.Column="2" Width="64" Height="16"
                                                                VerticalAlignment="Center" Points="{Binding Burndown}"
                                                                Visibility="{Binding IsSparklineVisible, Converter={StaticResource BoolToVis}}" />
                                                            <!-- Always show the number, not color alone (accessibility). -->
                                                            <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                Grid.Column="3"
                                                                MinWidth="40"
                                                                TextAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding PercentText}"
                                                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        </Grid>
                                                        <StackPanel
                                                            Margin="54,0,0,0"
                                                            Spacing="2">
                                                            <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                Opacity="0.7"
                                                                Text="{Binding CaptionText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap"
                                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                                            <!-- Absolute counts (e.g. "128 / 300") when the
                                                                 provider reports them; bar mode only. -->
                                                            <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                Opacity="0.55"
                                                                Text="{Binding CountsText}"
                                                                TextWrapping="Wrap"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Visibility="{Binding HasCounts, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                Opacity="0.7"
                                                                Text="{Binding PaceText}"
                                                                ToolTipService.ToolTip="{loc:Localize Key=Tooltip_Pace}"
                                                                TextWrapping="Wrap"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Visibility="{Binding HasPace, Converter={StaticResource BoolToVis}}" />
                                                            <!-- Measured burn-rate projection ("2시간 후
                                                                 소진 예상"); informational, so it keeps
                                                                 the dimmed caption styling. -->
                                                            <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                Opacity="0.7"
                                                                Text="{Binding EtaText}"
                                                                TextWrapping="Wrap"
                                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                                Visibility="{Binding HasEta, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Gauge layout: gauges grouped into family rows with a
                                             divider between families (Gemini | Claude/GPT), mirroring
                                             the bar layout. Ungrouped tools render as one row. Each
                                             row is a 2-up grid that wraps for >2 windows. -->
                                        <ItemsControl
                                            ItemsSource="{Binding GaugeGroups}"
                                            Visibility="{Binding IsGaugeMode, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <!-- Separator between adjacent model families. -->
                                                        <Border
                                                            Height="1"
                                                            Margin="0,2,0,8"
                                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                            Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}" />
                                                        <ItemsRepeater ItemsSource="{Binding Rows}">
                                                            <ItemsRepeater.Layout>
                                                                <UniformGridLayout MinItemWidth="130" MinColumnSpacing="8"
                                                                                   MinRowSpacing="6" ItemsStretch="Fill" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel HorizontalAlignment="Center" Spacing="3" Margin="0,2,0,8">
                                                                        <!-- Model-family name (grouped tools only). -->
                                                                        <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                            HorizontalAlignment="Center"
                                                                            Opacity="0.9"
                                                                            FontSize="12"
                                                                            Text="{Binding FamilyLabel}"
                                                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                            Visibility="{Binding HasFamilyLabel, Converter={StaticResource BoolToVis}}" />
                                                                        <!-- Window label (5시간 / 주간). -->
                                                                        <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                            HorizontalAlignment="Center"
                                                                            Opacity="0.75"
                                                                            FontSize="13"
                                                                            Text="{Binding Label}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <!-- Ring with the percent number/% stacked over its center. -->
                                                                        <Grid Width="90" Height="90" HorizontalAlignment="Center">
                                                                            <ctrl:UsageGauge
                                                                                Percent="{Binding Percent}"
                                                                                FillBrush="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                                    HorizontalAlignment="Center"
                                                                                    FontSize="26"
                                                                                    LineHeight="29"
                                                                                    Text="{Binding PercentNumber}"
                                                                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                                <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                                    HorizontalAlignment="Center"
                                                                                    Margin="0,-2,0,0"
                                                                                    Opacity="0.6"
                                                                                    FontSize="11"
                                                                                    Text="%"
                                                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <!-- Reset countdown. -->
                                                                        <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                            HorizontalAlignment="Center"
                                                                            TextAlignment="Center"
                                                                            TextWrapping="Wrap"
                                                                            Opacity="0.7"
                                                                            Text="{Binding ResetText}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                                                        <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                            HorizontalAlignment="Center"
                                                                            TextAlignment="Center"
                                                                            TextWrapping="Wrap"
                                                                            Opacity="0.7"
                                                                            Text="{Binding PaceText}"
                                                                            ToolTipService.ToolTip="{loc:Localize Key=Tooltip_Pace}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Visibility="{Binding HasPace, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock AutomationProperties.AccessibilityView="Raw"
                                                                            HorizontalAlignment="Center"
                                                                            TextAlignment="Center"
                                                                            TextWrapping="Wrap"
                                                                            Opacity="0.7"
                                                                            Text="{Binding EtaText}"
                                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                                            Visibility="{Binding HasEta, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </Grid>

                                        <!-- No windows for this tool at all. -->
                                        <TextBlock
                                            Text="{Binding StatusText}"
                                            Opacity="0.6"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Visibility="{Binding HasAnyData, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
                </Border>

                <!-- Footer bar: full-bleed strip with a top divider, mildly more opaque
                     than the acrylic body — like the Windows 11 Start menu bottom bar.
                     MinHeight + padding kept identical to the settings bar for a
                     consistent footer across both views. -->
                <Border Grid.Row="2"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Height="52"
                        Padding="16,9">
                    <Grid ColumnSpacing="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Opacity="0.7"
                            Text="{Binding LastUpdatedText}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource BorderlessIconButtonStyle}"
                            Padding="8,9"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="{loc:Localize Key=Tooltip_Refresh}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Style="{StaticResource BorderlessIconButtonStyle}"
                            Padding="8,9"
                            Click="OnSettingsClicked"
                            ToolTipService.ToolTip="{loc:Localize Key=Settings}">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Settings is a second view inside the same acrylic popover. Stretches so
             the update row can sit at the bottom (the window keeps the usage view's
             height while settings is shown). -->
        <Border x:Name="SettingsBorder" VerticalAlignment="Stretch" Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsViewTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header stays fixed; only the service list scrolls. -->
                <Border Grid.Row="0" Padding="16,16,16,8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource BorderlessIconButtonStyle}"
                                Click="OnSettingsBackClicked" ToolTipService.ToolTip="{loc:Localize Key=Tooltip_Back}">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{loc:Localize Key=Settings}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </Grid>
                </Border>

                <!-- Scrollable content: global toggles, then the service list. No
                     ScrollViewer bottom padding; the inner StackPanel carries a 12dip
                     bottom margin instead so the gap above the update bar at full scroll
                     matches the usage view's (its last card's 8dip + list's 4dip). The
                     list grows to a scroll as more services are registered or on a short
                     window — VerticalScrollBarVisibility=Auto turns the scrollbar on only
                     when the content actually exceeds the (usage-matched) panel height. -->
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" Padding="16,0,16,0">
                <StackPanel Spacing="8" VerticalAlignment="Top" Margin="0,0,0,12">
                    <!-- App-wide toggles, grouped in one card directly under the title:
                         usage notifications and run-on-startup. Two-way bound to the
                         GlobalSettingsViewModel; the empty On/Off content keeps the switch
                         compact and language-neutral. -->
                    <Border CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Padding="14,4">
                        <StackPanel>
                            <!-- Keep the disclosure row in the same visual grammar as every other
                                 setting: one flat 48dip row with a right-edge chevron. Notification
                                 kinds own the switches; the parent row only discloses those choices. -->
                            <Grid MinHeight="48" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_Notifications}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <Button x:Name="NotificationOptionsButton" Grid.Column="1"
                                        Width="40" Height="40" Padding="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource BorderlessIconButtonStyle}"
                                        Click="OnNotificationOptionsClicked"
                                    AutomationProperties.Name="{loc:Localize Key=Settings_Notifications}">
                                    <FontIcon x:Name="NotificationOptionsGlyph"
                                              Glyph="&#xE70D;" FontSize="12"
                                              RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform x:Name="NotificationOptionsGlyphRotation" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                            </Grid>
                            <!-- These two switches ARE the notification setting — there is no
                                 separate master — and the tray menu mirrors the same two, so
                                 neither surface can show a state the other contradicts. Two
                                 kinds only: per-tool matrices are deliberately not offered
                                 (settings density is a feature). -->
                            <StackPanel x:Name="NotificationKindRows"
                                        Height="0" Opacity="0" Visibility="Collapsed"
                                        RenderTransformOrigin="0.5,0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="NotificationKindRowsTransform" Y="-6" />
                                </StackPanel.RenderTransform>
                                <Border Height="1" Margin="0,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Margin="12,0,0,0">
                                    <Grid MinHeight="48" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{loc:Localize Key=Settings_NotifyThresholds}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ToggleSwitch Style="{StaticResource EdgeAlignedToggleSwitchStyle}" Grid.Column="1"
                                                      IsOn="{Binding Global.NotifyThresholds, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid MinHeight="48" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{loc:Localize Key=Settings_NotifyResets}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <ToggleSwitch Style="{StaticResource EdgeAlignedToggleSwitchStyle}" Grid.Column="1"
                                                      IsOn="{Binding Global.NotifyResets, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_StartOnBoot}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch Style="{StaticResource EdgeAlignedToggleSwitchStyle}" Grid.Column="1"
                                              IsOn="{Binding Global.StartOnBoot, Mode=TwoWay}" />
                            </Grid>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- View mode: a dropdown (not a toggle) since there are named
                                 choices — bar vs gauge — rather than an on/off state. -->
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_ViewMode}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                          ItemsSource="{Binding Global.ViewModeOptions}"
                                          SelectedIndex="{Binding Global.ViewModeIndex, Mode=TwoWay}" />
                            </Grid>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- Percent basis: whether the bars/gauges and their numbers show
                                 the used share (empty at 0%) or the remaining share (full at
                                 100% until quota is spent). A named choice, so a dropdown. -->
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_DisplayBasis}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                          ItemsSource="{Binding Global.DisplayBasisOptions}"
                                          SelectedIndex="{Binding Global.DisplayBasisIndex, Mode=TwoWay}" />
                            </Grid>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- Burndown sparkline on bar rows: an on/off state, so a toggle. -->
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_Sparkline}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch Style="{StaticResource EdgeAlignedToggleSwitchStyle}" Grid.Column="1"
                                              IsOn="{Binding Global.ShowSparkline, Mode=TwoWay}" />
                            </Grid>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- Weekly pace model: which days the multi-day windows' quota is
                                 expected to be spent on (every day / work days / from history).
                                 Three named choices, so a dropdown. -->
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_PaceModel}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                          ItemsSource="{Binding Global.PaceModelOptions}"
                                          SelectedIndex="{Binding Global.PaceModelIndex, Mode=TwoWay}" />
                            </Grid>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- API-equivalent cost on the card header: an on/off state, so a
                                 toggle. Off by default — on is what lets the app read the CLIs'
                                 local session logs (token counts only). -->
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_ApiCost}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ToggleSwitch Style="{StaticResource EdgeAlignedToggleSwitchStyle}" Grid.Column="1"
                                              IsOn="{Binding Global.ShowApiCost, Mode=TwoWay}" />
                            </Grid>
                            <Border Height="1" Margin="0,2"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- UI language. Options are each language's own native name, so
                                 the list itself needs no localization. Changing it persists
                                 the override and relaunches the app (language is fixed per
                                 process lifetime — XAML strings resolve at parse time). -->
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{loc:Localize Key=Settings_Language}"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                                          ItemsSource="{Binding Global.LanguageOptions}"
                                          SelectedIndex="{Binding Global.LanguageIndex, Mode=TwoWay}" />
                            </Grid>
                            <!-- settings.json notice: a write the file refused, or a document
                                 replaced because it stopped being JSON. Collapsed otherwise.
                                 Without it a switch that snapped back on its own reads as a
                                 bug rather than as the disk saying no. The text is bound, not
                                 localized here, because App picks which of the two it is. It
                                 carries no divider and no 48dip row height — it is not a
                                 setting, and sizing it like one would leave a gap in the
                                 normal case. -->
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding Global.SettingsNotice}"
                                       Foreground="{ThemeResource UsageCautionTextBrush}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{Binding Global.HasSettingsNotice, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- One card per tool, side by side at equal width and height.
                         Data-bound (not indexed) so adding a tool needs no XAML change. -->
                    <ItemsRepeater x:Name="AuthRepeater" ItemsSource="{Binding Authentication}"
                                   ItemTemplate="{StaticResource AuthCardTemplate}">
                        <ItemsRepeater.Layout>
                            <!-- MinItemWidth lets two cards share the ~328dip content width
                                 (8dip gap); ItemsStretch=Fill then stretches them to equal width. -->
                            <UniformGridLayout MinItemWidth="120" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
                </ScrollViewer>

                <!-- Bottom bar: version on the left, update action on the right. Same
                     full-bleed divider treatment, MinHeight and padding as the usage
                     view's footer so both views share an identical bottom bar. -->
                <Border Grid.Row="2"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Height="52"
                        Padding="16,9"
                        DataContext="{Binding Update}">
                    <Grid ColumnSpacing="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7"
                                   Text="{Binding VersionText}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <!-- Entry point to connect another service. A flyout (built in code
                             from the registry's available tools) picks which one to add.
                             Icon-only to match the header's borderless buttons; label is in the tooltip. -->
                        <Button x:Name="AddServiceButton" Grid.Column="1"
                                Style="{StaticResource BorderlessIconButtonStyle}"
                                Padding="8,9" VerticalAlignment="Center"
                                Click="OnAddServiceClicked"
                                ToolTipService.ToolTip="{loc:Localize Key=AddService}">
                            <FontIcon Glyph="&#xE192;" FontSize="14" />
                        </Button>
                        <!-- Update action: Sync glyph while checking, Download once a release is found.
                             Status/label surfaced on hover via the tooltip. While an action is
                             running, the button is swapped for a small ring spinner so the
                             (now hidden) installer's progress is reflected in-app. -->
                        <Grid Grid.Column="2">
                            <Button Style="{StaticResource BorderlessIconButtonStyle}"
                                    Padding="8,9" VerticalAlignment="Center"
                                    Command="{Binding ActionCommand}"
                                    ToolTipService.ToolTip="{Binding Tooltip}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <FontIcon Glyph="{Binding ActionGlyph}" FontSize="14" />
                            </Button>
                            <ProgressRing Width="16" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsActive="{Binding IsBusy}"
                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                          ToolTipService.ToolTip="{Binding Tooltip}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
