<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Gauge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Usage-level colors as named resources (never hardcoded inline at the
                 use site), defined per theme. The *Brush set colors bar/gauge FILLS —
                 large shapes where the saturated colors read fine on either acrylic.
                 The *TextBrush set colors small TEXT (refresh-issue badge, pace warning
                 caption): on light acrylic the fill amber/red fall well below readable
                 contrast, so the light theme uses the darker Fluent status-foreground
                 values instead. Dark text keeps the amber but brightens ok/danger —
                 the fill red is only ~3.5:1 against a dark card, below the 4.5:1 small
                 text needs (values are Fluent's dark status foregrounds). High contrast
                 defers entirely to the system palette. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="UsageOkBrush" Color="#2E9E4F" />
                    <SolidColorBrush x:Key="UsageCautionBrush" Color="#FEAD0C" />
                    <SolidColorBrush x:Key="UsageDangerBrush" Color="#FE140C" />
                    <SolidColorBrush x:Key="UsageOkTextBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="UsageCautionTextBrush" Color="#FEAD0C" />
                    <SolidColorBrush x:Key="UsageDangerTextBrush" Color="#FF99A4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="UsageOkBrush" Color="#2E9E4F" />
                    <SolidColorBrush x:Key="UsageCautionBrush" Color="#FEAD0C" />
                    <SolidColorBrush x:Key="UsageDangerBrush" Color="#FE140C" />
                    <SolidColorBrush x:Key="UsageOkTextBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="UsageCautionTextBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="UsageDangerTextBrush" Color="#C42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="UsageOkBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="UsageCautionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="UsageDangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="UsageOkTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UsageCautionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UsageDangerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Tray context menu (SecondWindow host) sizes its window from content and,
                 at fractional DPI, lands a couple physical pixels short of the presenter.
                 That makes the presenter's internal ScrollViewer show a scrollbar and
                 allow a few px of scroll. Disable scrolling outright — the menu is short
                 and fixed, so there is nothing to scroll — while keeping the native look. -->
            <Style x:Key="GaugeMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter"
                   BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- App font: bundled Pretendard JP (OFL 1.1), shipped under Assets/Fonts and
                 loaded read-only at runtime. Every WinUI text style (Body/Caption/Subtitle/…)
                 derives from BaseTextBlockStyle, which pulls FontFamily from
                 ContentControlThemeFontFamily; overriding that one key restyles all text and
                 controls in one shot. FontIcon uses SymbolThemeFontFamily, so glyphs are
                 untouched. The two static weights we actually use (Regular 400, SemiBold 600)
                 are separate files, so SemiBold text is pointed at the SemiBold file below to
                 render a real weight rather than a synthesized one. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/PretendardJP-Regular.otf#Pretendard JP</FontFamily>
            <FontFamily x:Key="AppFontSemiBold">ms-appx:///Assets/Fonts/PretendardJP-SemiBold.otf#Pretendard JP</FontFamily>

            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBold}" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{StaticResource AppFontSemiBold}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
